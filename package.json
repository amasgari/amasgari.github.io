{
  "name": "amasgari-github-io",
  "version": "1.0.0",
  "description": "Personal academic homepage for Amir Abbas Asgari",
  "repository": {
    "type": "git",
    "url": "https://github.com/amasgari/amasgari.github.io"
  },
  "keywords": [
    "academic",
    "homepage",
    "jekyll",
    "personal-site"
  ],
  "contributors": [],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/amasgari/amasgari.github.io/issues"
  },
  "homepage": "https://amasgari.github.io",
  "engines": {
    "node": ">= 0.10.0"
  },
  "dependencies": {
    "jquery": "^3.7.1",
    "plotly.js-dist-min": "^3.6.0"
  },
  "devDependencies": {
    "jslint": "^0.12.1",
    "onchange": "^7.1.0",
    "uglify-js": "^3.19.3"    
  },
  "scripts": {
    "uglify": "uglifyjs node_modules/jquery/dist/jquery.min.js assets/js/plugins/jquery.greedy-navigation.js assets/js/_main.js assets/js/theme.js -c -m -o assets/js/main.min.js",
    "watch:js": "onchange \"assets/js/**/*.js\" -e \"assets/js/main.min.js\" -- npm run build:js",
    "build:js": "npm run uglify"
  }
}
